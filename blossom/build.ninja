builddir = .build

rule ninja-meta
  command = ../target/flower configure
  description = rebuild build.ninja itself
rule flower-meta
  command = cd .. && clojure -T:build uberjar
  description = rebuild flower itself
rule flower-defaults
  command = cd ../defaults && ../target/flower configure
  description = rebuild default build.ninja
rule tmpdir
  command = mkdir -p .build
  description = create build dir
rule link
  command = ln -f $in $out
  description = link $in into build dir
rule page
  command = ../target/flower render-page <$in >$out
  description = render page $in using clojure
rule index
  command = ../target/flower render-index <$in >$out
  description = render index page $in using clojure
rule template
  command = ../target/flower embed-template $template < $in > $out
  description = embed $in into $template using clojure
rule frontmatter
  command = ../target/flower jq -R "{filename: \"$in\", content: .}" < $in | ../target/flower split-frontmatter > $out
rule sass
  command = sass --quiet $in $out; ../target/flower split-sass-dependencies $out <$source-map >$depfile
  description = compile Sass file $in to CSS
rule markdown
  command = ../target/flower render-markdown <$in >$out
  description = render markdown -> HTML: $in -> $out
rule transform
  command = < $in ../target/flower transform transformers/embed.clj | ../target/flower transform transformers/title.clj | ../target/flower split-dependencies $depfile $out | ../target/flower jq .content -r > $out
  description = run all transformers on $in

build build.ninja: ninja-meta pages/foo.md pages/index.md pages/look-ma-new-site.md pages/you-are-in-a-box.md templates/main.html templates/default.html templates/skeleton.html templates/icon-linkedin.svg templates/footer.html templates/icon-github.svg build.clj ../target/flower.jar pages pages templates templates expressions expressions sass/minima sass sass
  restat = true
build ../target/flower.jar: flower-meta ../flower/cmd.clj ../flower/beholder.clj ../flower/main.clj ../flower/reflect.clj ../flower/defaults.clj ../flower/utils.clj ../flower/watch.clj ../flower/hiccup.clj ../flower/internal ../flower/internal/utils.clj ../flower/frontmatter.clj ../flower/eval.clj ../flower/repl.clj ../defaults/pages ../defaults/pages/index.html ../defaults/pages/you-are-in-a-box.md ../defaults/pages/foo.md ../defaults/pages/look-ma-new-site.md ../defaults/expressions ../defaults/expressions/constants.clj ../defaults/expressions/ninja.clj ../defaults/expressions/meta.clj ../defaults/expressions/example.clj ../defaults/expressions/html.clj ../defaults/public ../defaults/public/you-are-in-a-box.html ../defaults/public/index.html ../defaults/public/xxx ../defaults/public/foo.html ../defaults/public/look-ma-new-site.html ../defaults/templates ../defaults/templates/default.html ../defaults/templates/skeleton.html ../defaults/templates/main.html ../defaults/transformers ../defaults/transformers/embed.clj ../defaults/transformers/title.clj ../defaults/build.clj ../defaults/build.ninja ../flower ../deps.edn
build ../defaults/build.ninja: flower-defaults ../defaults/build.clj
build .build: tmpdir 
build public/minima.css: sass sass/minima.scss
  source-map = public/minima.css.map
  depfile = .build/minima.scss.d
build .build/index.md.json: frontmatter pages/index.md | ../target/flower.jar
build .build/index.rendered.md: index .build/index.md.json | build.ninja pages/foo.md pages/look-ma-new-site.md pages/you-are-in-a-box.md expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
build public/index.html: transform .build/index.rendered.html | transformers/embed.clj transformers/title.clj expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
  depfile = .build/index.rendered.html.d
build .build/index.rendered.html: markdown .build/index.rendered.md | ../target/flower.jar
build public/index.rendered.html: link .build/index.rendered.html
build .build/foo.md.json: frontmatter pages/foo.md | ../target/flower.jar
build .build/foo.rendered.md: page .build/foo.md.json | expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
build public/foo.html: transform .build/foo.rendered.html | transformers/embed.clj transformers/title.clj expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
  depfile = .build/foo.rendered.html.d
build .build/foo.rendered.html: markdown .build/foo.rendered.md | ../target/flower.jar
build public/foo.rendered.html: link .build/foo.rendered.html
build .build/look-ma-new-site.md.json: frontmatter pages/look-ma-new-site.md | ../target/flower.jar
build .build/look-ma-new-site.rendered.md: page .build/look-ma-new-site.md.json | expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
build public/look-ma-new-site.html: transform .build/look-ma-new-site.rendered.html | transformers/embed.clj transformers/title.clj expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
  depfile = .build/look-ma-new-site.rendered.html.d
build .build/look-ma-new-site.rendered.html: markdown .build/look-ma-new-site.rendered.md | ../target/flower.jar
build public/look-ma-new-site.rendered.html: link .build/look-ma-new-site.rendered.html
build .build/you-are-in-a-box.md.json: frontmatter pages/you-are-in-a-box.md | ../target/flower.jar
build .build/you-are-in-a-box.rendered.md: page .build/you-are-in-a-box.md.json | expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
build public/you-are-in-a-box.html: transform .build/you-are-in-a-box.rendered.html | transformers/embed.clj transformers/title.clj expressions/ninja.clj expressions/html.clj expressions/constants.clj expressions/meta.clj expressions/example.clj
  depfile = .build/you-are-in-a-box.rendered.html.d
build .build/you-are-in-a-box.rendered.html: markdown .build/you-are-in-a-box.rendered.md | ../target/flower.jar
build public/you-are-in-a-box.rendered.html: link .build/you-are-in-a-box.rendered.html
