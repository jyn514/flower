builddir = .build

build flower: phony ../target/flower
rule transform
  command = < $in ../target/flower transform transformers/embed.clj | ../target/flower transform transformers/title.clj | ../target/flower split-dependencies $in.d $out | ../target/flower jq .content -r > $out
  description = run all transformers on $in
rule ninja-meta
  command = ../target/flower configure
  description = rebuild build.ninja itself
rule flower-meta
  command = cd .. && clojure -T:build native-dev
  description = rebuild flower itself
rule flower-defaults
  command = cd ../defaults && ../target/flower configure
  description = rebuild default build.ninja
rule tmpdir
  command = mkdir -p .build
  description = create build dir
rule link
  command = ln -f $in $out
  description = link $in into build dir
rule page
  command = ../target/flower render-page < $in | ../target/flower split-dependencies $in.d $out > $out
  description = render page $in using clojure
rule index
  command = ../target/flower render-index < $in | ../target/flower split-dependencies $in.d $out > $out
  description = render index page $in using clojure
rule template
  command = ../target/flower embed-template $template < $in > $out
  description = embed $in into $template using clojure
rule frontmatter
  command = ../target/flower jq -R --filename $in '{filename: $$filename, content: .}' < $in | ../target/flower split-frontmatter > $out
rule sass
  command = sass --quiet $in $out; ../target/flower split-sass-dependencies $out <$source-map >$depfile
  description = compile Sass file $in to CSS
rule markdown
  command = ../target/flower render-markdown < $in > $out
  description = render markdown -> HTML: $in -> $out

