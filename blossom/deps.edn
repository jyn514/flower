 {:deps {
    instaparse/instaparse {:mvn/version "1.5.0"}
    hiccup/hiccup {:mvn/version "2.0.0"}
    org.babashka/sci {:mvn/version "0.10.47"}
    org.clojure/data.json {:mvn/version "2.5.1"}
    io.forward/yaml {:mvn/version "1.0.11"}
    io.github.tonsky/toml-clj {:mvn/version "0.1.0"}
    org.jsoup/jsoup {:mvn/version "1.21.1"}
    io.github.nextjournal/markdown {:mvn/version "0.7.186"}}
  :paths ["."]
  :aliases {
    ; :default-deps {instaparse/instaparse {:mvn/version "1.5.0"}}
    :extra-paths ["parse.clj"]
    :test
      {:extra-paths ["parse.clj"]
      :extra-deps  {lambdaisland/kaocha {:mvn/version "1.77.1236"}}
      :exec-fn     kaocha.runner/exec-fn
      :exec-args   {:skip-meta :slow}}

      :watch
      {:exec-args   {:watch?     true
                    :skip-meta  :slow
                    :fail-fast? true}}}}
