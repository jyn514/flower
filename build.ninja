rule tmpdir
  command = mkdir -p .build
  description = create build dir
build .build: tmpdir
rule link
  command = ln -f $in $out
  description = link $in into build dir
rule blossom
  command = clj -M --main blossom render-page < $in > $out
  description = render $in -> $out using clojure
rule markdown
  command = pulldown-cmark -TFSULG $in > $out
  description = render markdown -> HTML: $in -> $out
rule frontmatter
  command = clj -M --main blossom split-frontmatter < $in > $out
build .build/look-ma-new-site.md.json: frontmatter src/look-ma-new-site.md $
    | blossom.clj
build .build/look-ma-new-site.md: blossom .build/look-ma-new-site.md.json | $
    blossom.clj
build public/look-ma-new-site.html: markdown .build/look-ma-new-site.md
rule ninja-meta
  command = scripts/gen.py
  description = rebuild build.ninja itself
build build.ninja: ninja-meta scripts/gen.py src
  generator = true
