builddir = .build

rule ninja-meta
  command = clj -M --main flower.core configure
  description = rebuild build.ninja itself
rule tmpdir
  command = mkdir -p .build
  description = create build dir
rule link
  command = ln -f $in $out
  description = link $in into build dir
rule page
  command = clj -M --main flower.core render-page <$in >$out
  description = render page $in using clojure
rule index
  command = clj -M --main flower.core render-index <$in >$out
  description = render index page $in using clojure
rule template
  command = clj -M --main flower.core embed-template $template < $in > $out
  description = embed $in into $template using clojure
rule frontmatter
  command = clj -M --main flower.core split-frontmatter <$in >$out
rule markdown
  command = pulldown-cmark -TFSULG $in -> $out
  description = render markdown -> HTML: $in -> $out
rule postprocess
  command = < $in clj -M --main flower.core postprocess postprocessors/title.clj | clj -M --main flower.core jq .content -r > $out
  description = run all postprocessors on $in

build build.ninja: ninja-meta pages/you-are-in-a-box.md pages/foo.md pages/look-ma-new-site.md templates/default.html templates/index.html templates/main.html build.clj deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
build .build: tmpdir 
build .build/you-are-in-a-box.md.json: frontmatter pages/you-are-in-a-box.md | deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
build .build/you-are-in-a-box.md.rendered.json: page .build/you-are-in-a-box.md.json
build .build/you-are-in-a-box.html.embed: template .build/you-are-in-a-box.md.rendered.json | templates/default.html deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
  template = templates/default.html
build public/you-are-in-a-box.html: postprocess .build/you-are-in-a-box.html.embed | postprocessors/title.clj
  html = .build/you-are-in-a-box.html.embed
build .build/foo.md.json: frontmatter pages/foo.md | deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
build .build/foo.md.rendered.json: page .build/foo.md.json
build .build/foo.html.embed: template .build/foo.md.rendered.json | templates/default.html deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
  template = templates/default.html
build public/foo.html: postprocess .build/foo.html.embed | postprocessors/title.clj
  html = .build/foo.html.embed
build .build/look-ma-new-site.md.json: frontmatter pages/look-ma-new-site.md | deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
build .build/look-ma-new-site.md.rendered.json: page .build/look-ma-new-site.md.json
build .build/look-ma-new-site.html.embed: template .build/look-ma-new-site.md.rendered.json | templates/default.html deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
  template = templates/default.html
build public/look-ma-new-site.html: postprocess .build/look-ma-new-site.html.embed | postprocessors/title.clj
  html = .build/look-ma-new-site.html.embed
build .build/index.md.json: frontmatter templates/index.html | deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
build .build/index.md.rendered.json: index .build/index.md.json | build.ninja
build .build/index.html.embed: template .build/index.md.rendered.json | templates/default.html deps.edn flower/parse.clj flower/select.clj flower/utils.clj flower/build.clj
  template = templates/default.html
build public/index.html: postprocess .build/index.html.embed | postprocessors/title.clj
  html = .build/index.html.embed
